---
import type { GearSection } from '../lib/gear';
interface Props { section: GearSection; }
const { section } = Astro.props;
---
<section aria-labelledby="gear-heading" class="mt-12 rounded-card border border-line bg-surface-soft p-5 sm:p-6">
  <h2 id="gear-heading" class="text-xl font-bold text-ink">{section.heading}</h2>
  <p class="mt-2 leading-relaxed text-muted">{section.intro}</p>
  <ul class="mt-4 grid gap-4 sm:grid-cols-2">
    {section.items.map((item) => (
      <li>
        <h3 class="font-semibold text-ink">{item.name}</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted">{item.note}</p>
        <a href={item.href} class="mt-2 inline-block text-sm font-medium text-brand-strong link-underline">What to check →</a>
      </li>
    ))}
  </ul>
</section>
