---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { absoluteUrl, formatTitle } from '../lib/utils';
import { breadcrumbSchema } from '../lib/seo';
import { categories } from '../lib/data';
import { SITE } from '../site.config';

const site = Astro.site;
const description = `About ${SITE.name} — who is behind this directory of sensory-friendly places for kids, what we cover, and how to get in touch.`;
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: absoluteUrl('/', site) },
    { name: 'About', url: absoluteUrl('/about/', site) },
  ]),
];
---

<BaseLayout
  title={formatTitle('About')}
  description={description}
  canonicalPath="/about/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'About' }]} />

    <h1 class="mt-6 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      About {SITE.name}
    </h1>

    <div class="mt-6 space-y-5 leading-relaxed text-muted prose-readable">
      <p>
        {SITE.name} is a directory of sensory-friendly and autism-friendly places
        and services for children. We started it for a simple reason: finding out
        whether somewhere will work for a sensory-sensitive child is far harder
        than it should be. The details that matter — whether the lights can be
        dimmed, whether staff are patient, whether there's a quieter time of day —
        are rarely on a business's website, and they're exactly what we collect here.
      </p>

      <h2 class="pt-2 text-xl font-bold text-ink">Who's behind it</h2>
      <p>
        Alex runs this independent directory. It brings together published
        venue information and practical planning resources for families.
        Inclusion is not a personal review, a clinical recommendation or a
        certification issued by this site.
      </p>

      <h2 class="pt-2 text-xl font-bold text-ink">What we cover</h2>
      <p>
        We organize places by category and by city, across {categories.length}{' '}
        categories — haircuts, museums, movie screenings, play and entertainment,
        zoos and attractions, theater, inclusive playgrounds, library storytimes,
        and shopping — in cities across the US, UK, Ireland, Australia and Canada.
        There are also seasonal guides for Halloween, meeting Santa, fireworks,
        flying, and Disney World, plus a free <a class="link-underline text-brand-strong" href="/outing-planner/">outing planner</a>.
        City pages contain specific local venues. National programs are listed
        separately on category pages because a chain-wide program does not
        establish that a particular branch takes part. Some cities have only
        one or two entries; those pages make the coverage limit clear.
      </p>

      <h2 class="pt-2 text-xl font-bold text-ink">How we keep it accurate</h2>
      <p>
        Every listing is checked against the venue's own page or a recognized
        certification before it goes live, and shows the date we last checked it.
        We haven't personally visited every place, so most entries are marked
        "Documented — confirm locally": treat them as a well-researched starting
        point and confirm the specifics with the venue before you go. You can read
        exactly how we do this on our{' '}
        <a class="link-underline font-medium text-brand-strong" href="/how-we-verify/">
          How We Verify
        </a>{' '}
        page.
      </p>

      <h2 class="pt-2 text-xl font-bold text-ink">Help us improve a listing</h2>
      <p>
        If something here is out of date, or you know a great place we've missed,
        please tell us — corrections from families are one of our most valuable
        sources. Email us at{' '}
        <a
          class="link-underline font-medium text-brand-strong"
          href={`mailto:${SITE.contactEmail}`}
        >
          {SITE.contactEmail}
        </a>.
      </p>
    </div>
  </div>
</BaseLayout>
