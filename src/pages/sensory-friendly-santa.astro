---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { absoluteUrl, formatTitle } from '../lib/utils';
import { breadcrumbSchema, faqSchema } from '../lib/seo';
const title = "Sensory-Friendly Santa & Sensitive Santa Events";
const heading = "Finding a sensory-friendly Santa visit";
const crumb = "Sensory-friendly Santa";
const description = "Find current sensory Santa sessions, distinguish past events from confirmed dates, ask about accommodations and photo costs, and plan a flexible visit.";
const intro = "A Santa visit can mean waving from a distance, delivering a letter, sitting beside a caregiver, or choosing not to approach. The useful question is what the event changes to make those choices possible. Check the actual session before promising your child a particular experience.";
const provenance = "Research guide. Cherry Hill Programs' Santa Cares program page was checked October 28, 2026. It describes the program in general; this page does not establish any 2026 date, participating location, reservation window, or photo price.";
const sections = [
  {
    "heading": "Know which program you are looking at",
    "body": "Names include Santa Cares, Caring Santa, Sensitive Santa, and sensory-friendly Santa. Similar names do not guarantee identical arrangements or the same organizer.<br /><br />On its <a href=\"https://santacares.whereissanta.com/\" class=\"link-underline text-brand-strong\">Santa Cares page</a>, Cherry Hill Programs describes reduced lighting and music, advance registration to keep numbers small, and a Santa and staff trained for those visits. That describes the program in general, not confirmation that your local venue is running it this year."
  },
  {
    "heading": "Find a current local session",
    "body": "Begin with your mall's official events page, then its named Santa photography provider. Cherry Hill's report directs families to <a href=\"https://whereissanta.com/\" class=\"link-underline text-brand-strong\">Where Is Santa</a>. Also check your library, community center, or local disability organization's calendar for its own events.<br /><br />Look for the year, full venue address, date, session title, and reservation link. A social post without a year or a search result for a previous December should be treated as a lead. If nothing current is published, ask when the venue expects to announce its plans."
  },
  {
    "heading": "Ask six questions before paying",
    "body": "Ask what changes during this particular session: music, lighting, crowd limits, waiting arrangements, appointment length, and access to a break space. A timed reservation may still include a wait, so ask what happens if the previous visit runs late.<br /><br />Confirm whether participation requires buying photographs, what the total price is, whether caregivers and siblings can attend, and the cancellation or rescheduling terms. Ask how to communicate preferences to Santa and the photographer before the visit begins."
  },
  {
    "heading": "Describe your child's preferred encounter",
    "body": "A short note might say: “Please let us approach at our own pace”; “We would like to wave”; or “Please ask before touching or moving a chair.” Choose only what fits your child. Ask whether staff can accommodate it, including a visit without a photograph.<br /><br />You can also ask for a photograph of the current setup, directions to the entrance used for the session, and a description of where families wait. Older event photos may show a different layout."
  },
  {
    "heading": "Make the visit easy to finish",
    "body": "Tell your child what is optional and agree on a word, gesture, or device message for stopping. Keep familiar communication and comfort items accessible. Leave space afterward for a break instead of booking another time-sensitive activity.<br /><br />If you arrive and the conditions differ from what was described, speak with the organizer before joining the queue. Decide whether an adjustment, another appointment, or leaving is the best choice. There is no minimum visit length to achieve."
  },
  {
    "heading": "Keep another way to enjoy the tradition",
    "body": "A letter, a drawing, looking at pictures, or waving at an outdoor display can be complete activities. A video call is another possibility if the child wants one; check its cost, privacy arrangements, and cancellation terms first.<br /><br />Choose the alternative together when possible. Record what was enjoyable, what was uncertain, and the questions you would ask before another visit. A child's preferred way to participate may stay the same, and that is fine."
  }
];
const faqs = [
  {
    "question": "Are 2026 Santa sessions confirmed on this page?",
    "answer": "No. Use the venue's current event page and reservation confirmation for dates and availability. The sourced program example here is explicitly from 2024."
  },
  {
    "question": "When do bookings open?",
    "answer": "There is no verified common opening date in this guide. Ask the specific organizer when its current season will be released."
  },
  {
    "question": "Must my child sit on Santa's lap or have a photograph?",
    "answer": "Make your child's preference part of the booking conversation and check whether the organizer can accommodate it. Choose a different format if the offered visit does not fit."
  }
];
const sources = [
  {
    "label": "Cherry Hill Programs: Santa Cares",
    "url": "https://santacares.whereissanta.com/"
  }
];
const jsonLd = [breadcrumbSchema([{ name: 'Home', url: absoluteUrl('/', Astro.site) }, { name: crumb, url: absoluteUrl('/sensory-friendly-santa/', Astro.site) }]), faqSchema(faqs)];
---
<BaseLayout title={formatTitle(title)} description={description} canonicalPath="/sensory-friendly-santa/" jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: crumb }]} />
    <h1 class="mt-6 text-3xl font-bold tracking-tight text-ink sm:text-4xl">{heading}</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted prose-readable">{intro}</p>
    <p class="mt-5 rounded-card border border-line bg-surface-soft p-4 text-sm leading-relaxed text-muted">{provenance}</p>
    <div class="mt-10 space-y-9 prose-readable">
      {sections.map((section) => (
        <section>
          <h2 class="text-2xl font-bold text-ink">{section.heading}</h2>
          <p class="mt-3 leading-relaxed text-muted" set:html={section.body} />
        </section>
      ))}
    </div>
    <section class="mt-12 rounded-card border border-line bg-surface-soft p-5">
      <h2 class="text-xl font-bold text-ink">Sources and corrections</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">
        {sources.map((source) => <li><a class="link-underline text-brand-strong" href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}
      </ul>
      <p class="mt-4 text-sm leading-relaxed text-muted">Source checks describe the documents reviewed, not a guarantee of current local availability. <a class="link-underline text-brand-strong" href="/contact/">Send a correction</a> with the official source and the detail that changed. See <a class="link-underline text-brand-strong" href="/how-we-verify/">how we check information</a>.</p>
    </section>
    <div class="mt-12"><Faq faqs={faqs} heading={crumb + ': questions'} id="sensory-friendly-santa-faq" /></div>
    <p class="mt-10 leading-relaxed text-muted">Planning another outing? <a class="link-underline text-brand-strong" href="/cities/">Browse local sensory-friendly venues</a> and use our <a class="link-underline text-brand-strong" href="/sensory-gear/">sensory kit comparison guide</a> to decide what you already have and what to check before buying.</p>
  </article>
</BaseLayout>
