---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import {
  categories,
  getCitiesWithCategory,
  getProgramsForCategory,
  type Category,
} from '../../lib/data';
import {
  absoluteUrl,
  categoryPath,
  cityHubPath,
  cityPath,
  formatTitle,
  truncate,
  formatDate,
} from '../../lib/utils';
import { breadcrumbSchema, faqSchema, itemListSchema } from '../../lib/seo';

interface Props {
  category: Category;
}

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const site = Astro.site;

const entries = getCitiesWithCategory(category.slug);
const dedicated = entries.filter((e) => e.qualifies);
const hubOnly = entries.filter((e) => !e.qualifies && e.hubQualifies);
const nationalPrograms = getProgramsForCategory(category.slug);
const countryNames: Record<string, string> = {
  US: 'United States', GB: 'United Kingdom', IE: 'Ireland', AU: 'Australia', CA: 'Canada',
};

const path = categoryPath(category);
const title = `Sensory-Friendly ${category.shortLabel}`;
// Kept short enough that the longest category name ("Sensory-Friendly Zoos,
// Aquariums & Attractions") still fits the 160-char budget without truncation.
const description = truncate(
  `${category.name} for kids, organized by city — with the sensory details, ` +
    `schedules, and accommodations that matter up front.`,
  160,
);

const crumbs = [
  { name: 'Home', url: absoluteUrl('/', site) },
  { name: category.name, url: absoluteUrl(path, site) },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  itemListSchema(
    `${category.name} — cities`,
    entries.map((entry) => ({
      name: `${entry.city.city}, ${entry.city.stateAbbr}`,
      url: absoluteUrl(
        entry.qualifies ? cityPath(category, entry.city) : cityHubPath(entry.city),
        site,
      ),
    })),
  ),
  faqSchema(category.faqs),
];
---

<BaseLayout
  title={formatTitle(title)}
  description={description}
  canonicalPath={path}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: category.name }]} />

    <header class="mt-6 max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        {category.name}
      </h1>
      <p class="mt-3 text-lg font-medium text-brand-strong">{category.tagline}</p>
      <p class="mt-4 leading-relaxed text-muted prose-readable">
        {category.description}
      </p>
    </header>

    <section aria-labelledby="cities-heading" class="mt-12">
      <h2 id="cities-heading" class="text-2xl font-bold text-ink">
        Choose your city
      </h2>

      {
        dedicated.length > 0 && (
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {dedicated.map((entry) => (
              <li>
                <a
                  href={cityPath(category, entry.city)}
                  class="block h-full rounded-card border border-line bg-surface p-5 transition-colors hover:border-brand hover:bg-brand-soft/30"
                >
                  <span class="text-lg font-semibold text-ink">
                    {entry.city.city}, {entry.city.stateAbbr}
                  </span>
                  <span class="mt-1 block text-sm text-muted">
                    {entry.count} {entry.count === 1 ? 'listing' : 'listings'} →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        hubOnly.length > 0 && (
          <div class="mt-8">
            <h3 class="text-sm font-semibold text-ink">
              Local listings in more cities
            </h3>
            <p class="mt-1 text-sm text-muted">
              These city guides have a smaller selection. The count reflects sourced local places.
            </p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {hubOnly.map((entry) => (
                <li>
                  <a
                    href={cityHubPath(entry.city)}
                    class="inline-block rounded-full border border-line bg-surface px-3 py-1 text-sm text-muted transition-colors hover:border-brand hover:text-brand-strong"
                  >
                    {entry.city.city}, {entry.city.stateAbbr} ({entry.count})
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        entries.length === 0 && (
          <p class="mt-6 max-w-2xl rounded-card border border-line bg-surface p-6 text-muted">
            We have no sourced local venue listings in this category yet. Use the
            program references and planning questions below to research an option near you.
          </p>
        )
      }
    </section>

    <section id="programs" aria-labelledby="programs-heading" class="mt-14 scroll-mt-24">
      <h2 id="programs-heading" class="text-2xl font-bold text-ink">
        National and multi-location program references
      </h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        A chain may offer a sensory program at selected branches. Use its official
        location finder or schedule to confirm a specific venue before traveling.
        These references are listed once here and are separate from local venue counts.
      </p>
      {nationalPrograms.length > 0 ? (
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {nationalPrograms.map((program) => (
            <article id={program.id} class="rounded-card border border-line bg-surface p-5">
              <h3 class="text-lg font-bold text-ink">{program.name}</h3>
              <p class="mt-1 text-sm text-muted">
                {countryNames[program.country ?? 'US'] ?? program.country} · {program.operator}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-muted">{program.schedule}</p>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">
                {program.sensoryFeatures.map((feature) => <li>{feature}</li>)}
              </ul>
              <p class="mt-4 text-sm leading-relaxed text-muted">{program.parentTip}</p>
              <p class="mt-4 text-sm">
                <a class="link-underline font-semibold text-brand-strong" href={program.website} target="_blank" rel="noopener">
                  Official program and participating locations ↗
                </a>
              </p>
              <p class="mt-3 text-xs text-muted">
                <a class="link-underline" href={program.sourceUrl} target="_blank" rel="noopener">Published source</a>
                {' '}· Source checked {formatDate(program.lastVerified)}. Confirm current availability.
              </p>
            </article>
          ))}
        </div>
      ) : (
        <p class="mt-4 text-muted">We have no national program references for this category yet.</p>
      )}
    </section>

    <section class="mt-14 max-w-3xl rounded-card border border-line bg-surface p-6">
      <h2 class="text-2xl font-bold text-ink">Questions to ask before you book</h2>
      <p class="mt-4 leading-relaxed text-muted">{category.guide}</p>
    </section>

    <div class="mt-16 max-w-3xl">
      <Faq faqs={category.faqs} />
    </div>

    <section class="mt-14 max-w-3xl rounded-card bg-brand-soft/40 p-6 sm:p-8">
      <h2 class="text-xl font-bold text-ink">How these listings are chosen</h2>
      <p class="mt-3 leading-relaxed text-muted prose-readable">
        Local entries link to a source and include a source-check date. National
        program pages do not establish which branches participate. Read our process
        on the{' '}
        <a class="link-underline font-medium text-brand-strong" href="/how-we-verify/">
          How We Verify
        </a>{' '}
        page.
      </p>
    </section>
  </div>
</BaseLayout>
