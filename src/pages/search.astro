---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  categories,
  listings,
  getCity,
  getCategory,
  getListingsFor,
  cityHubQualifies,
  listingCoords,
  effectiveStatus,
  MIN_LISTINGS_PER_CITY,
} from '../lib/data';
import { cityHubPath, cityPath, formatTitle } from '../lib/utils';

interface Row {
  id: string;
  name: string;
  categorySlug: string;
  categoryName: string;
  cityName: string;
  stateAbbr: string;
  lat: number;
  lng: number;
  features: string[];
  status: string;
  href: string;
}

const rows: Row[] = listings
  .map((l): Row | null => {
    const coords = listingCoords(l);
    const city = getCity(l.citySlug);
    const category = getCategory(l.category);
    if (!coords || !city || !category) return null;

    // Prefer an internal link: city hub anchor, then category-in-city, else the
    // official site.
    let href = l.website;
    if (cityHubQualifies(l.citySlug)) {
      href = `${cityHubPath(city)}#${l.id}`;
    } else if (getListingsFor(l.category, l.citySlug).length >= MIN_LISTINGS_PER_CITY) {
      href = `${cityPath(category, city)}#${l.id}`;
    }

    return {
      id: l.id,
      name: l.name,
      categorySlug: l.category,
      categoryName: category.name,
      cityName: city.city,
      stateAbbr: city.stateAbbr,
      lat: coords.lat,
      lng: coords.lng,
      features: l.sensoryFeatures.slice(0, 3),
      status: effectiveStatus(l),
      href,
    };
  })
  .filter((r): r is Row => r !== null)
  .sort(
    (a, b) =>
      a.cityName.localeCompare(b.cityName) ||
      a.categoryName.localeCompare(b.categoryName),
  );

/**
 * Compact, dictionary-encoded payload for the client.
 *
 * Server-rendering all ~3,700 rows as markup produced a 4.4 MB page with
 * ~37,000 DOM nodes, and every filter change re-appended all of them. Instead
 * we ship the rows as data and render only the handful actually on screen
 * (see RENDER_CAP in the client script below). Category names, city labels and
 * sensory-feature strings repeat heavily across rows, so they are interned into
 * lookup tables and referenced by index.
 */
const catSlugs = categories.map((c) => c.slug);
const catNames = categories.map((c) => c.name);

const placeLabels: string[] = [];
const placeIndex = new Map<string, number>();
const featureLabels: string[] = [];
const featureIndex = new Map<string, number>();

const intern = (
  value: string,
  table: string[],
  index: Map<string, number>,
): number => {
  const existing = index.get(value);
  if (existing !== undefined) return existing;
  const id = table.push(value) - 1;
  index.set(value, id);
  return id;
};

/** [id, name, categoryIdx, placeIdx, lat, lng, featureIdxs, href] */
type PackedRow = [string, string, number, number, number, number, number[], string];

const packedRows: PackedRow[] = rows.map((r) => {
  const catIdx = catSlugs.indexOf(r.categorySlug);
  // A -1 here would make the row invisible in every filter with no error, so
  // fail the build instead of shipping a silently missing listing.
  if (catIdx < 0) {
    throw new Error(
      `search: listing "${r.id}" has category "${r.categorySlug}", which is not in categories.json`,
    );
  }
  return [
    r.id,
    r.name,
    catIdx,
    intern(`${r.cityName}, ${r.stateAbbr}`, placeLabels, placeIndex),
    Number(r.lat.toFixed(4)),
    Number(r.lng.toFixed(4)),
    r.features.map((f) => intern(f, featureLabels, featureIndex)),
    r.href,
  ];
});

const searchPayload = {
  cats: catSlugs,
  catNames,
  places: placeLabels,
  feats: featureLabels,
  rows: packedRows,
};

// Calendar data (recurring times + specific dates) keyed by listing id. The
// search-page calendar is rebuilt from whichever listings are within the radius.
const hrefById: Record<string, string> = Object.fromEntries(
  rows.map((r) => [r.id, r.href]),
);
const calData: Record<
  string,
  { name: string; recurrence: unknown[]; dates: string[]; href: string; scheduleText: string }
> = {};
for (const l of listings) {
  const recurrence = l.recurrence ?? [];
  const dates = l.sensoryEventDates ?? [];
  if (recurrence.length || dates.length) {
    calData[l.id] = {
      name: l.name,
      recurrence,
      dates,
      href: hrefById[l.id] || l.website,
      scheduleText: l.schedule ?? l.hours ?? '',
    };
  }
}

const description =
  'Enter your zip or postal code to find sensory-friendly and autism-friendly places for kids near you — movies, museums, play, and more, sorted by distance.';
---

<BaseLayout
  noindex={true}
  title={formatTitle('Find Sensory-Friendly Places Near You')}
  description={description}
  canonicalPath="/search/"
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <header class="max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Find sensory-friendly places near you
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted prose-readable">
        Enter your zip or postal code to see sensory-friendly places for kids
        sorted by approximate distance — US, UK, Canada, and Australia. You can also filter
        by what you're looking for.
      </p>
    </header>

    {/* Search controls */}
    <form id="zip-form" class="mt-8 rounded-card border border-line bg-surface p-5 sm:p-6">
      <div class="flex flex-wrap items-end gap-4">
        <div>
          <label for="zip" class="block text-sm font-semibold text-ink">
            Zip / postal code
          </label>
          <input
            id="zip"
            name="zip"
            type="text"
            autocomplete="postal-code"
            maxlength="8"
            placeholder="e.g. 78205 or SW1A"
            aria-describedby="zip-help"
            class="mt-1 w-44 rounded-lg border border-line bg-canvas px-3 py-2 text-ink placeholder:text-muted/70 focus:border-brand"
          />
          <p id="zip-help" class="mt-1 text-xs text-muted">
            US, UK, Canada, or Australia
          </p>
        </div>
        <div>
          <label for="radius" class="block text-sm font-semibold text-ink">
            Within
          </label>
          <select
            id="radius"
            name="radius"
            class="mt-1 rounded-lg border border-line bg-canvas px-3 py-2 text-ink focus:border-brand"
          >
            <option value="10">10 miles</option>
            <option value="25" selected>25 miles</option>
            <option value="50">50 miles</option>
            <option value="100">100 miles</option>
          </select>
        </div>
        <button
          type="submit"
          class="rounded-lg bg-brand px-5 py-2.5 font-semibold text-white transition-colors hover:bg-brand-strong"
        >
          Search
        </button>
        <button
          type="button"
          id="geo-btn"
          class="link-underline py-2.5 text-sm font-semibold text-brand-strong"
        >
          Use my location
        </button>
        <button
          type="button"
          id="reset-btn"
          class="py-2.5 text-sm text-muted hover:text-brand-strong"
          hidden
        >
          Clear
        </button>
      </div>

      {/* Category filters */}
      <fieldset class="mt-5 border-t border-line pt-4">
        <legend class="text-sm font-semibold text-ink">Show</legend>
        <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
          {
            categories.map((c) => (
              <label class="flex items-center gap-2 text-sm text-muted">
                <input
                  type="checkbox"
                  class="cat-filter h-4 w-4 rounded border-line text-brand focus:ring-brand"
                  value={c.slug}
                  checked
                />
                {c.name}
              </label>
            ))
          }
        </div>
      </fieldset>
    </form>

    <p id="result-summary" class="mt-6 text-sm font-medium text-ink" aria-live="polite">
      {rows.length} places listed. Enter a zip or postal code to find what's nearest you.
    </p>

    {/* Shown alongside a lookup failure, so "browse by city" is always a real link. */}
    <p id="search-fallback" class="mt-2 text-sm text-muted" hidden>
      <a class="link-underline font-medium text-brand-strong" href="/cities/">
        Browse every city instead →
      </a>
    </p>

    {/* Calendar — rebuilt from the places within the searched radius */}
    <section
      id="search-calendar"
      class="mt-6 rounded-card border border-line bg-surface p-5 sm:p-6"
      hidden
    >
      <h2 class="text-lg font-bold text-ink">Upcoming sensory-friendly dates nearby</h2>
      <p class="mt-1 text-sm text-muted">
        The next dates for the places shown below — always confirm the exact time
        with each venue.
      </p>
      <ul id="search-calendar-list" class="mt-4 grid gap-2 sm:grid-cols-2"></ul>
    </section>

    <script
      type="application/json"
      id="search-cal-data"
      set:html={JSON.stringify(calData)}
    />

    <script
      type="application/json"
      id="search-rows-data"
      set:html={JSON.stringify(searchPayload)}
    />

    <ul id="results" class="mt-4 grid gap-3"></ul>

    <p id="results-more" class="mt-4 text-sm text-muted" hidden></p>

    <noscript>
      <p class="mt-4 rounded-card border border-line bg-surface p-6 text-muted">
        Distance search needs JavaScript. You can still
        <a class="link-underline font-medium text-brand-strong" href="/cities/">
          browse every city
        </a>
        — each city page lists the sensory-friendly places near it.
      </p>
    </noscript>

    <p id="no-results" class="mt-4 rounded-card border border-line bg-surface p-6 text-muted" hidden>
      No places match within that distance yet. Try a larger radius, or
      <a class="link-underline font-medium text-brand-strong" href="/cities/">browse by city</a>.
      We add new listings regularly.
    </p>
  </div>
</BaseLayout>

<script>
  import { computeUpcoming } from '../lib/calendarUtils';

  // ---- Zip-code radius search (client-side, no backend) ----
  const R_MILES = 3958.8;
  const toRad = (d: number) => (d * Math.PI) / 180;
  function haversine(aLat: number, aLng: number, bLat: number, bLng: number) {
    const dLat = toRad(bLat - aLat);
    const dLng = toRad(bLng - aLng);
    const h =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(toRad(aLat)) * Math.cos(toRad(bLat)) * Math.sin(dLng / 2) ** 2;
    return 2 * R_MILES * Math.asin(Math.sqrt(h));
  }

  const form = document.getElementById('zip-form') as HTMLFormElement | null;
  const zipInput = document.getElementById('zip') as HTMLInputElement | null;
  const radiusSel = document.getElementById('radius') as HTMLSelectElement | null;
  const resultsEl = document.getElementById('results') as HTMLUListElement | null;
  const summaryEl = document.getElementById('result-summary');
  const noResultsEl = document.getElementById('no-results');
  const geoBtn = document.getElementById('geo-btn');
  const resetBtn = document.getElementById('reset-btn');
  const catFilters = Array.from(
    document.querySelectorAll<HTMLInputElement>('.cat-filter'),
  );

  /** How many result cards we put in the DOM at once. Results are distance-sorted,
   *  so the nearest ones are always the ones shown. */
  const RENDER_CAP = 60;

  type PackedRow = [string, string, number, number, number, number, number[], string];
  interface SearchPayload {
    cats: string[];
    catNames: string[];
    places: string[];
    feats: string[];
    rows: PackedRow[];
  }

  if (form && zipInput && radiusSel && resultsEl && summaryEl && noResultsEl) {
    const rowsDataEl = document.getElementById('search-rows-data');
    const empty: SearchPayload = { cats: [], catNames: [], places: [], feats: [], rows: [] };
    // A throw here would take the whole script down — no submit handler, no
    // Clear, no render — and the page would sit on its server-rendered text
    // forever. Fail loudly to the visitor instead, and give them a way out.
    let payload: SearchPayload = empty;
    let payloadOk = false;
    try {
      const parsed = JSON.parse(rowsDataEl?.textContent || 'null');
      if (parsed && Array.isArray(parsed.rows)) {
        payload = parsed;
        payloadOk = true;
      }
    } catch {
      /* handled below */
    }
    const allRows = payload.rows || [];
    const moreEl = document.getElementById('results-more');
    const fallbackEl = document.getElementById('search-fallback');

    let center: { lat: number; lng: number; label: string } | null = null;

    const calSection = document.getElementById('search-calendar');
    const calListEl = document.getElementById('search-calendar-list');
    const calDataEl = document.getElementById('search-cal-data');
    const calData: Record<string, any> = calDataEl
      ? JSON.parse(calDataEl.textContent || '{}')
      : {};

    const activeCats = () =>
      new Set(catFilters.filter((c) => c.checked).map((c) => c.value));

    /** Build one result card. Kept as DOM calls (not innerHTML) so listing
     *  names and feature text can never be interpreted as markup. */
    function buildCard(row: PackedRow, dist: number | null): HTMLLIElement {
      const [, name, catIdx, placeIdx, , , featIdxs, href] = row;

      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = href;
      a.className =
        'block rounded-card border border-line bg-surface p-4 transition-colors hover:border-brand hover:bg-brand-soft/20';

      const head = document.createElement('div');
      head.className = 'flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1';
      const nameEl = document.createElement('span');
      nameEl.className = 'font-semibold text-ink';
      nameEl.textContent = name;
      head.appendChild(nameEl);
      if (dist !== null) {
        const distEl = document.createElement('span');
        distEl.className = 'text-sm font-medium text-brand-strong';
        distEl.textContent = `${dist < 10 ? dist.toFixed(1) : Math.round(dist)} mi`;
        head.appendChild(distEl);
      }

      const meta = document.createElement('p');
      meta.className = 'mt-0.5 text-sm text-muted';
      meta.textContent = `${payload.catNames[catIdx] ?? ''} · ${payload.places[placeIdx] ?? ''}`;

      const feats = document.createElement('ul');
      feats.className = 'mt-2 flex flex-wrap gap-1.5';
      for (const fi of featIdxs) {
        const f = document.createElement('li');
        f.className =
          'rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-medium text-brand-strong';
        f.textContent = payload.feats[fi] ?? '';
        feats.appendChild(f);
      }

      a.append(head, meta, feats);
      li.appendChild(a);
      return li;
    }

    /** Show or hide the standing 'browse every city' escape hatch. */
    const showFallback = (on: boolean) => { if (fallbackEl) fallbackEl.hidden = !on; };

    function render() {
      if (!payloadOk) {
        showFallback(true);
        summaryEl!.textContent =
          "Something went wrong loading the list of places. Reload the page, or browse by city instead.";
        resultsEl!.replaceChildren();
        if (moreEl) moreEl.hidden = true;
        noResultsEl!.hidden = false;
        return;
      }
      showFallback(false);
      const cats = activeCats();
      const radius = Number(radiusSel!.value);

      // Score every row, but only the matches ever become DOM nodes.
      const matches: { row: PackedRow; dist: number | null }[] = [];
      for (const row of allRows) {
        if (!cats.has(payload.cats[row[2]])) continue;
        const dist = center ? haversine(center.lat, center.lng, row[4], row[5]) : null;
        if (dist !== null && dist > radius) continue;
        matches.push({ row, dist });
      }
      if (center) matches.sort((a, b) => (a.dist ?? Infinity) - (b.dist ?? Infinity));

      const visible = matches.length;
      const visibleIds = matches.map((m) => m.row[0]);

      const shown = matches.slice(0, RENDER_CAP);
      const frag = document.createDocumentFragment();
      for (const m of shown) frag.appendChild(buildCard(m.row, m.dist));
      resultsEl!.replaceChildren(frag);

      if (moreEl) {
        const hidden = visible - shown.length;
        moreEl.hidden = hidden <= 0;
        // Matches are distance-sorted, so the ones on screen are always the
        // nearest: a smaller radius only ever returns a prefix of them. Don't
        // suggest it — unticking a category, or opening a city page, is what
        // actually reaches the rest.
        moreEl.textContent = hidden > 0
          ? center
            ? `Showing the ${shown.length} closest of ${visible}. Untick a category above to narrow the list, or open a city page to see everything there.`
            : `Showing the first ${shown.length} of ${visible}. Enter a zip or postal code above to see what's nearest you.`
          : '';
      }

      noResultsEl!.hidden = visible > 0;
      if (center) {
        summaryEl!.textContent = `${visible} ${
          visible === 1 ? 'place' : 'places'
        } within ${radius} miles of ${center.label}.`;
      } else {
        summaryEl!.textContent = `${visible} ${
          visible === 1 ? 'place' : 'places'
        } listed. Enter a zip or postal code to find what's nearest you.`;
      }
      if (resetBtn) resetBtn.hidden = !center;
      renderCalendar(visibleIds);
    }

    function renderCalendar(ids: string[]) {
      if (!calSection || !calListEl) return;
      // Only show the calendar once a zip/location search has narrowed the area.
      if (!center) {
        calSection.hidden = true;
        return;
      }
      const calItems = ids.map((id) => calData[id]).filter(Boolean);
      const occ = computeUpcoming(calItems, 75);
      if (occ.length === 0) {
        calSection.hidden = true;
        return;
      }
      calSection.hidden = false;
      const fmt = new Intl.DateTimeFormat('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
      });
      calListEl.innerHTML = '';
      for (const o of occ.slice(0, 10)) {
        const li = document.createElement('li');
        li.className = 'flex flex-wrap gap-x-2 text-sm';
        const d = document.createElement('span');
        d.className = 'w-24 shrink-0 font-semibold text-ink';
        d.textContent = fmt.format(o.date);
        const desc = document.createElement('a');
        desc.href = o.href || '#';
        desc.className =
          'text-brand-strong underline decoration-1 underline-offset-2 hover:text-brand';
        desc.textContent = o.note ? `${o.name} · ${o.note}` : o.name;
        li.append(d, desc);
        calListEl.appendChild(li);
      }
    }

    /**
     * Candidate lookups for a typed code, most likely first.
     *
     * The geocoder covers US, UK, Canada and Australia. A three-character code
     * like "M5V" is a valid Canadian FSA *and* a valid UK outward code, so
     * ambiguous inputs yield more than one candidate and we try each in turn.
     * Irish Eircodes are not in the dataset — handled separately below.
     */
    function postalCandidates(raw: string): { country: string; code: string }[] {
      const v = raw.trim().toUpperCase().replace(/\s+/g, ' ');
      const compact = v.replace(/ /g, '');
      const out: { country: string; code: string }[] = [];
      if (/^\d{5}$/.test(v)) out.push({ country: 'us', code: v });
      if (/^\d{4}$/.test(v)) out.push({ country: 'au', code: v });
      // Canadian FSA: first three chars of "A1A 1A1" (no D, F, I, O, Q, U, W, Z lead).
      if (/^[ABCEGHJKLMNPRSTVXY]\d[A-Z]( ?\d[A-Z]\d)?$/.test(v))
        out.push({ country: 'ca', code: compact.slice(0, 3) });
      // UK outward code — the "SW1A" of "SW1A 1AA". The inward code is always
      // three characters, so anything longer than a bare outward code (max 4)
      // has its last three trimmed. Splitting on the space would not do: people
      // routinely type the postcode without one.
      if (/^[A-Z]{1,2}\d[A-Z\d]?( ?\d[A-Z]{2})?$/.test(v))
        out.push({
          country: 'gb',
          code: compact.length > 4 ? compact.slice(0, -3) : compact,
        });
      return out;
    }

    /** True for something that looks like an Irish Eircode ("D02 X285"). */
    const looksIrish = (raw: string) =>
      /^[AC-FHKNPRTV-Y]\d[\dW] ?[0-9AC-FHKNPRTV-Y]{4}$/.test(
        raw.trim().toUpperCase(),
      );

    async function searchZip(zip: string) {
      const candidates = postalCandidates(zip);
      if (candidates.length === 0) {
        summaryEl!.textContent = looksIrish(zip)
          ? "We can't look up Eircodes yet — pick your city from the full list instead."
          : 'Enter a US zip code, or a UK, Canadian, or Australian postal code.';
        showFallback(true);
        return;
      }

      summaryEl!.textContent = 'Looking up your area…';

      // Three outcomes to tell apart: we got a clean "no such code" answer, the
      // service answered but was broken (5xx / unparseable), or we never
      // reached it at all. Only the first is the user's problem to fix.
      let gotCleanAnswer = false;
      let serviceBroken = false;
      let found: { lat: number; lng: number; label: string } | null = null;

      for (const { country, code } of candidates) {
        try {
          const res = await fetch(`https://api.zippopotam.us/${country}/${code}`);
          if (res.status >= 500) {
            serviceBroken = true;
            continue;
          }
          if (!res.ok) {
            gotCleanAnswer = true; // a real 404: this country has no such code.
            continue;
          }
          const data = await res.json();
          const place = data.places && data.places[0];
          if (!place) {
            gotCleanAnswer = true;
            continue;
          }
          const region = place['state abbreviation'] || place.state || '';
          // Some postal areas carry very long official names (Canadian FSAs
          // list every neighbourhood) — keep the label to the first one.
          const placeName = String(place['place name'] || '')
            .split('/')[0]
            // Splitting can leave a parenthesis open ("Downtown Toronto (CN
            // Tower"); drop the dangling fragment rather than show it.
            .replace(/\s*\([^)]*$/, '')
            .trim();
          found = {
            lat: Number(place.latitude),
            lng: Number(place.longitude),
            label: `${zip.trim().toUpperCase()} (${placeName}${region ? `, ${region}` : ''})`,
          };
          break;
        } catch {
          // Network/CORS failure, or a non-JSON body from a captive portal.
          serviceBroken = true;
        }
      }

      // render() stays outside the try: a bug in rendering must not be caught
      // here and reported to the user as a bad postal code.
      if (found) {
        center = found;
        render();
        return;
      }

      showFallback(true);
      summaryEl!.textContent =
        gotCleanAnswer && !serviceBroken
          ? "We couldn't find that postal code. Check it and try again."
          : "We couldn't reach the location lookup service just now. Please try again in a moment, or browse by city.";
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      searchZip(zipInput.value.trim());
    });
    catFilters.forEach((c) => c.addEventListener('change', render));
    radiusSel.addEventListener('change', render);

    if (geoBtn) {
      geoBtn.addEventListener('click', () => {
        if (!navigator.geolocation) {
          summaryEl!.textContent = 'Location isn’t available in this browser.';
          return;
        }
        summaryEl!.textContent = 'Getting your location…';
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            center = {
              lat: pos.coords.latitude,
              lng: pos.coords.longitude,
              label: 'your location',
            };
            zipInput.value = '';
            render();
          },
          () => {
            summaryEl!.textContent =
              'We couldn’t get your location. Try entering a zip code instead.';
          },
        );
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        center = null;
        zipInput.value = '';
        render();
      });
    }

    // Auto-run if arriving with ?zip=NNNNN (e.g. from the homepage search box).
    const params = new URLSearchParams(window.location.search);
    const presetZip = params.get('zip');
    const presetRadius = params.get('radius');
    if (presetRadius && ['10', '25', '50', '100'].includes(presetRadius)) {
      radiusSel.value = presetRadius;
    }

    // Rows live in a JSON payload, so the list starts empty — paint the browse
    // state before anything else. searchZip() re-renders once it has a centre.
    render();

    if (presetZip) {
      zipInput.value = presetZip;
      searchZip(presetZip);
    }
  }
</script>
