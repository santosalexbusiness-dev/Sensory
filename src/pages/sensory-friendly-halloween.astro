---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { absoluteUrl, formatTitle } from '../lib/utils';
import { breadcrumbSchema, faqSchema } from '../lib/seo';
const title = "Sensory-Friendly Halloween & Trick-or-Treating";
const heading = "A sensory-friendly Halloween and trick-or-treating guide";
const crumb = "Sensory-friendly Halloween";
const description = "Plan comfortable costumes, a short Halloween route, communication choices, non-food treats, and specific questions for sensory event organizers.";
const intro = "Halloween brings several choices that can be made separately: a costume, visiting neighbors, receiving treats, decorations, and being outside after dark. Your child can enjoy one part and skip another. This guide helps you choose a small plan and prepare an easy way to change it.";
const provenance = "Research guide. FARE's Teal Pumpkin Project and CPSC costume and pedestrian safety guidance were checked September 7, 2026. Local Halloween sessions and dates have not been confirmed by this page.";
const sections = [
  {
    "heading": "Start with clothes your child chooses",
    "body": "Offer the costume at home before making plans around it. Check seams, fastenings, temperature, and whether your child can move, see, and use the bathroom comfortably. A familiar outfit, themed shirt, or no costume can be the finished choice.<br /><br />CPSC recommends a well-fitting costume that does not trail on the ground, visibility aids such as reflective trim, and a flashlight. Its <a href=\"https://www.cpsc.gov/s3fs-public/100.pdf\" class=\"link-underline text-brand-strong\">Halloween safety guide</a> also covers fabrics, masks, and walking near traffic."
  },
  {
    "heading": "Make a route with a clear finish",
    "body": "Choose a few familiar homes and a simple way back. Walk the route beforehand if that is useful, noting roads to cross, uneven surfaces, decorations, and places you can turn around. Ask neighbors when they expect to welcome visitors; an early visit is not automatically available or quiet.<br /><br />Instead of promising a fixed number of houses, offer a stopping point after each visit. Let another adult know the route and decide who is responsible for accompanying each child. A location-tracking device does not replace that supervision."
  },
  {
    "heading": "Offer communication without a performance",
    "body": "Your child can wave, use a communication device, hold out a bucket, or have an adult speak. If they want a card, a neutral message can be enough: “Happy Halloween! Thank you for welcoming us.” They do not need to disclose a diagnosis to participate.<br /><br />Practice the doorway sequence only if your child wants to. Ask a familiar neighbor to make the first visit predictable, including any preference about doorbells, costumes, or handing over treats."
  },
  {
    "heading": "Understand what a teal pumpkin signals",
    "body": "FARE's <a href=\"https://www.foodallergy.org/our-initiatives/awareness-campaigns/teal-pumpkin-project\" class=\"link-underline text-brand-strong\">Teal Pumpkin Project</a> encourages households to offer non-food treats separately from sweets and use a teal pumpkin or sign to show participation. It is a food-allergy inclusion initiative; it does not certify a house as quiet or sensory-friendly.<br /><br />Check what is offered and whether an item is appropriate for your child's age and needs. If hosting, make the choice visible and easy to request without requiring a child to explain why."
  },
  {
    "heading": "Compare an organized event before booking",
    "body": "Ask about the exact session, capacity, sound effects, strobe lighting, scare actors, waiting areas, and somewhere to take a break. Check whether adults need tickets, whether arrival windows are flexible, and what happens if you leave early.<br /><br />A trunk-or-treat, zoo event, or museum event can still include loud music and crowds. Look for a current, explicit description of the accommodations. A venue's year-round sensory program does not establish the details of its Halloween event."
  },
  {
    "heading": "Prepare an at-home version with equal status",
    "body": "Options include decorating one room, watching a familiar film, choosing a treat together, or visiting doors inside your home. If giving out treats is enjoyable, decide who answers the door and how to stop when your child is finished.<br /><br />Keep the alternative ready before you leave so changing plans does not require another decision under pressure. Afterward, record one thing your child enjoyed and one thing to ask about next time. Participation does not have to increase year by year."
  }
];
const faqs = [
  {
    "question": "Does my child have to say “trick or treat”?",
    "answer": "No. Choose a greeting, gesture, device, or adult support that suits your child. A diagnosis or explanation is not required."
  },
  {
    "question": "Does a teal pumpkin mean a sensory-friendly house?",
    "answer": "It signals participation in an initiative offering non-food treats. Ask separately about sound, lights, decorations, and access."
  },
  {
    "question": "How do I find a sensory-friendly Halloween event?",
    "answer": "Use official local calendars, then check the organizer's current session details. Ask for the specific changes to noise, lighting, queues, and crowd size."
  }
];
const sources = [
  {
    "label": "FARE: Teal Pumpkin Project",
    "url": "https://www.foodallergy.org/our-initiatives/awareness-campaigns/teal-pumpkin-project"
  },
  {
    "label": "CPSC: Halloween safety (PDF)",
    "url": "https://www.cpsc.gov/s3fs-public/100.pdf"
  }
];
const jsonLd = [breadcrumbSchema([{ name: 'Home', url: absoluteUrl('/', Astro.site) }, { name: crumb, url: absoluteUrl('/sensory-friendly-halloween/', Astro.site) }]), faqSchema(faqs)];
---
<BaseLayout title={formatTitle(title)} description={description} canonicalPath="/sensory-friendly-halloween/" jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: crumb }]} />
    <h1 class="mt-6 text-3xl font-bold tracking-tight text-ink sm:text-4xl">{heading}</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted prose-readable">{intro}</p>
    <p class="mt-5 rounded-card border border-line bg-surface-soft p-4 text-sm leading-relaxed text-muted">{provenance}</p>
    <div class="mt-10 space-y-9 prose-readable">
      {sections.map((section) => (
        <section>
          <h2 class="text-2xl font-bold text-ink">{section.heading}</h2>
          <p class="mt-3 leading-relaxed text-muted" set:html={section.body} />
        </section>
      ))}
    </div>
    <section class="mt-12 rounded-card border border-line bg-surface-soft p-5">
      <h2 class="text-xl font-bold text-ink">Sources and corrections</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">
        {sources.map((source) => <li><a class="link-underline text-brand-strong" href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}
      </ul>
      <p class="mt-4 text-sm leading-relaxed text-muted">Source checks describe the documents reviewed, not a guarantee of current local availability. <a class="link-underline text-brand-strong" href="/contact/">Send a correction</a> with the official source and the detail that changed. See <a class="link-underline text-brand-strong" href="/how-we-verify/">how we check information</a>.</p>
    </section>
    <div class="mt-12"><Faq faqs={faqs} heading={crumb + ': questions'} id="sensory-friendly-halloween-faq" /></div>
    <p class="mt-10 leading-relaxed text-muted">Planning another outing? <a class="link-underline text-brand-strong" href="/cities/">Browse local sensory-friendly venues</a> and use our <a class="link-underline text-brand-strong" href="/sensory-gear/">sensory kit comparison guide</a> to decide what you already have and what to check before buying.</p>
  </article>
</BaseLayout>
